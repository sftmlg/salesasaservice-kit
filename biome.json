{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "files": {
    "includes": ["**", "!**/dist", "!**/node_modules", "!docs/openapi.json", "!docs/procedure-catalogue.md"]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 110 },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "useNamingConvention": {
          "level": "error",
          "options": {
            "strictCase": false,
            "conventions": [
              {
                "selector": { "kind": "objectLiteralProperty" },
                "formats": ["camelCase", "CONSTANT_CASE", "PascalCase"]
              },
              {
                "selector": { "kind": "typeProperty" },
                "formats": ["camelCase", "CONSTANT_CASE"]
              }
            ]
          }
        },
        "noNestedTernary": "error",
        "noParameterAssign": "error",
        "useForOf": "error"
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": { "level": "error", "options": { "maxAllowedComplexity": 15 } },
        "noExcessiveLinesPerFunction": { "level": "error", "options": { "maxLines": 50 } }
      }
    }
  },
  "overrides": [
    {
      "includes": ["packages/saas-kit/src/openapi.ts"],
      "linter": { "rules": { "style": { "useNamingConvention": "off" } } }
    },
    {
      "includes": ["packages/*/tests/**"],
      "linter": { "rules": { "complexity": { "noExcessiveLinesPerFunction": "off" } } }
    }
  ]
}
